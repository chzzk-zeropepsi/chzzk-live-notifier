<Window
    x:Class="ChzzkNotifier.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="368" Height="104"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize">

    <Border x:Name="Card" CornerRadius="10" Background="#F52B2D31"
            BorderBrush="#5865F2" BorderThickness="1" Cursor="Hand"
            MouseLeftButtonUp="Card_Click">
        <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="56" Height="56" CornerRadius="28" Background="#2A2C33"
                    VerticalAlignment="Center">
                <Border.Clip>
                    <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28" />
                </Border.Clip>
                <Image x:Name="Avatar" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeaderText" Foreground="#8891F2" FontSize="12"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Foreground="#9AA0A6" FontSize="12"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="✕" Foreground="#9AA0A6" FontSize="12"
                       VerticalAlignment="Top" Margin="8,10,0,0" Cursor="Hand"
                       MouseLeftButtonUp="Close_Click" />
        </Grid>
    </Border>
</Window>
