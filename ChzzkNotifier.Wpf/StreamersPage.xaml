<Page
    x:Class="ChzzkNotifier.StreamersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="스트리머">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 디스코드 멤버 목록 스타일 행 -->
        <Style x:Key="MemberRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E3E5E8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D7D9DD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="14,6,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="6,2,0,8" Text="알림 받는 스트리머"
                   Foreground="#5C5E66" FontSize="12" FontWeight="SemiBold" />

        <ListView x:Name="FollowList" Grid.Row="1" Background="Transparent"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource MemberRow}"
                  MouseDoubleClick="FollowList_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 아바타 + 상태 점 -->
                        <Grid Width="42" Height="42">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#E3E5E8"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Border.Clip>
                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                </Border.Clip>
                                <Image Source="{Binding ImageUrl, IsAsync=True}" Stretch="UniformToFill" />
                            </Border>
                            <Ellipse Width="16" Height="16" HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom" StrokeThickness="3" Stroke="#F2F3F5">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#80848E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Fill" Value="#23A55A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>

                        <!-- 이름 + LIVE 배지 + 활동 -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Foreground="#313338"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Background="#593695" CornerRadius="4" Padding="5,1"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="LIVE" Foreground="White"
                                               FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ActivityText}" Foreground="#5C5E66"
                                       FontSize="12" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Margin="2,8,2,4">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="방송 열기" Click="OpenButton_Click" />
                <ui:Button Content="제거" Margin="8,0,0,0" Click="RemoveButton_Click" />
                <ui:Button Content="지금 새로고침" Margin="8,0,0,0" Click="RefreshButton_Click" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" Content="🔔 알림 테스트"
                       Appearance="Primary" Click="TestButton_Click" />
        </Grid>
    </Grid>
</Page>
