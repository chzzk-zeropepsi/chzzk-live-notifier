<ui:FluentWindow
    x:Class="ChzzkNotifier.AddStreamerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="스트리머 추가"
    Width="500" Height="580" MinWidth="420" MinHeight="440"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="#313338"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="스트리머 추가" ShowMinimize="False" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="스트리머 이름 검색"
                        Icon="{ui:SymbolIcon Search24}" KeyDown="SearchBox_KeyDown" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="검색"
                       Appearance="Primary" Click="SearchButton_Click" />
        </Grid>

        <ListView x:Name="SearchList" Grid.Row="2" Margin="16,0,16,8"
                  MouseDoubleClick="SearchList_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#2A2C33">
                            <Border.Clip>
                                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                            </Border.Clip>
                            <Image Source="{Binding ImageUrl, IsAsync=True}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding DisplayName}" FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                   Text="{Binding FollowerText}" Foreground="#9AA0A6" FontSize="12" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Width="20"
                                   Text="{Binding LiveMark}" Foreground="#FF5252" FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" Margin="16,0,16,12">
            <TextBlock x:Name="HintText" VerticalAlignment="Center"
                       Foreground="#9AA0A6" FontSize="12"
                       Text="더블클릭으로 바로 추가할 수 있어요" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="추가" Appearance="Primary" Click="AddButton_Click" />
                <ui:Button Content="닫기" Margin="8,0,0,0" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
